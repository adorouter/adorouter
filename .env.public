# Public build-time config. NOT secrets: Next.js inlines every NEXT_PUBLIC_* into the
# browser bundle, so these ship to every visitor regardless. Kept in git so a build
# needs no secret store for them.
NEXT_PUBLIC_API_URL=https://api.adorouter.com
NEXT_PUBLIC_APP_NAME=AdoRouter
NEXT_PUBLIC_CARDS_URL=https://adorouter.com
NEXT_PUBLIC_GITHUB_URL=https://github.com/adorouter
NEXT_PUBLIC_SUPPORT_EMAIL=support@adorouter.com
NEXT_PUBLIC_URL=https://adorouter.com
